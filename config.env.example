# 复制成 config.env 填好（Windows 下用记事本改完另存为 .env，注意不要存成 .env.txt）
# 已经存在的环境变量优先于这里的值

# ---------- 微信 4.x 数据位置 ----------
# xwechat_files 根目录，例如 C:\Users\你的用户名\Documents\xwechat_files
# 不确定就别填：doctor.py 会自动从 %APPDATA%\Tencent\xwechat\config\*.ini 里找
WECHAT_DATA_DIR=

# ---------- 解密导出工具（必填） ----------
# 微信 4.x 的库是 SQLCipher 4 加密的，必须用专门的取密钥工具。
# 装好之后把它的命令行写在这里，daily.bat 会先跑它，再做归一化和出日报。
# 首选（微信 4.1.10.31+ / 4.2 专用链路，跑完 setup.bat 后可用）：
#   EXPORT_CMD="C:\Python314\python.exe" "C:\你的路径\wechat4.py" export
# 备选（微信 4.0 及更早，用 wxq；先跑 setup_wxq.bat）：
#   EXPORT_CMD="C:\Python314\python.exe" "C:\你的路径\export_via_wxq.py"
EXPORT_CMD=

# 导出文件放哪（导出和归一化都读这个目录）
EXPORT_DIR=C:\Users\你的用户名\wx_export

# ---------- 飞书中转 ----------
WEIXIN_BRIDGE=feishu
FS_APP_ID=
FS_APP_SECRET=
# 表格 URL 里的 app_token 与 table_id
FS_TABLE_ID=appXXXXXXXX/tblYYYYYYYY
FS_FIELD_DATE=日期
FS_FIELD_MSG=消息数
FS_FIELD_PAYLOAD=内容
FS_FIELD_REPORT=日报

# ---------- 本机摘要（OpenAI 兼容接口） ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.cn/v1
LLM_MODEL=MiniMax-M3.1-Flash
LLM_EFFORT=medium

# 日报范围：mine = 只保留「我发过言」的会话（默认）；all = 全部会话都进日报
DAILY_SCOPE=mine
# 以我为中心裁剪上下文：保留我发言前后 N 条消息。0 = 只留我自己的；-1 = 不裁剪
DAILY_CONTEXT_WINDOW=5
# 白名单群名（逗号分隔）：这些群不管我有没有说话都进日报；群名包含关键字即命中
DAILY_INCLUDE_CHATS=
# 白名单群我不在里面说话时，最多保留最近多少条
DAILY_INCLUDE_MAX=50

# ---------- 其他 ----------
# PYTHON=python
